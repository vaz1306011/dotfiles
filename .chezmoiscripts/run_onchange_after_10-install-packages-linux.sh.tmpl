{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Installs the tools the dotfiles rely on. Tools whose apt version is too old
# (fzf, neovim) or that are not in apt (nvm, uv) come from upstream.
set -euo pipefail

BIN="$HOME/.local/bin"
mkdir -p "$BIN"
export PATH="$BIN:$PATH"

case "$(uname -m)" in
  x86_64)         NVIM_ARCH=x86_64 ;;
  aarch64|arm64)  NVIM_ARCH=arm64 ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

# version_ge HAVE NEED: true when HAVE >= NEED
version_ge() { [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1)" = "$2" ]; }

# latest_tag OWNER/REPO: resolve the latest release tag via redirect (no API rate limit)
latest_tag() {
  local url
  url=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/$1/releases/latest")
  echo "${url##*/}"
}

# --- apt ---
APT_PKGS=(git curl zsh tmux tree build-essential gh)
missing=()
for p in "${APT_PKGS[@]}"; do
  dpkg -s "$p" >/dev/null 2>&1 || missing+=("$p")
done
if [ "${#missing[@]}" -gt 0 ]; then
  sudo apt-get update
  sudo apt-get install -y "${missing[@]}"
fi

# --- fzf (needs >= 0.48 for `fzf --zsh`) ---
if ! command -v fzf >/dev/null 2>&1 || ! version_ge "$(fzf --version | awk '{print $1}')" 0.48; then
  rm -rf "$HOME/.fzf"
  git clone --depth 1 https://github.com/junegunn/fzf.git "$HOME/.fzf"
  "$HOME/.fzf/install" --bin
  ln -sf "$HOME/.fzf/bin/fzf" "$BIN/fzf"
fi

# --- neovim (LazyVim needs >= 0.11) ---
if ! command -v nvim >/dev/null 2>&1 || ! version_ge "$(nvim --version | head -n1 | sed 's/^NVIM v//')" 0.11; then
  tmp=$(mktemp -d)
  curl -fsSL "https://github.com/neovim/neovim/releases/latest/download/nvim-linux-${NVIM_ARCH}.tar.gz" | tar -xz -C "$tmp"
  rm -rf "$HOME/.local/nvim"
  mv "$tmp"/nvim-linux-* "$HOME/.local/nvim"
  ln -sf "$HOME/.local/nvim/bin/nvim" "$BIN/nvim"
  rm -rf "$tmp"
fi

# --- nvm (PROFILE=/dev/null keeps the installer from editing shell rc files) ---
if [ ! -s "$HOME/.nvm/nvm.sh" ]; then
  curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/$(latest_tag nvm-sh/nvm)/install.sh" | PROFILE=/dev/null bash
fi

# --- uv ---
if ! command -v uv >/dev/null 2>&1; then
  curl -LsSf https://astral.sh/uv/install.sh | UV_NO_MODIFY_PATH=1 sh
fi
{{- end }}
